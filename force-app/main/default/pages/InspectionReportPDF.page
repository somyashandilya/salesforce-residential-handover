<apex:page controller="InspectionReportPDFController" renderAs="pdf" applyBodyTag="false" docType="html-5.0" showHeader="false" sidebar="false">
    <head>
        <title>Inspection Report - {!IF(hasInspection, inspection.Name, 'Document')}</title>
        <style type="text/css">
            @page {
                size: A4 portrait;
                margin: 1.2cm 1.2cm 1.4cm 1.2cm;
                @bottom-right {
                    content: "Page " counter(page) " of " counter(pages);
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 8pt;
                    color: #64748B;
                }
                @bottom-left {
                    content: "Residential Handover Audit Report | Confidential";
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 8pt;
                    color: #64748B;
                }
            }

            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 9pt;
                color: #0F172A;
                line-height: 1.35;
                margin: 0;
                padding: 0;
            }

            /* ── Header Band ── */
            .header-banner {
                background-color: #0B2345;
                color: #FFFFFF;
                padding: 14px 18px;
                border-radius: 4px;
                margin-bottom: 14px;
            }

            .header-title {
                font-size: 15pt;
                font-weight: bold;
                letter-spacing: 0.5px;
                margin: 0;
                text-transform: uppercase;
                color: #FFFFFF;
            }

            .header-subtitle {
                font-size: 9pt;
                color: #CBD5E1;
                margin-top: 3px;
            }

            .header-right {
                text-align: right;
                font-size: 8.5pt;
                color: #E2E8F0;
            }

            .ref-badge {
                display: inline-block;
                background-color: #1E3A8A;
                color: #FFFFFF;
                padding: 3px 8px;
                border-radius: 3px;
                font-weight: bold;
                font-size: 9pt;
            }

            /* ── Context Grid ── */
            .context-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 14px;
                background-color: #F8FAFC;
                border: 1px solid #CBD5E1;
                border-radius: 4px;
            }

            .context-table td {
                padding: 6px 10px;
                vertical-align: top;
                font-size: 8.5pt;
                border-bottom: 1px solid #E2E8F0;
            }

            .context-label {
                font-size: 7.5pt;
                font-weight: bold;
                color: #475569;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                display: block;
                margin-bottom: 2px;
            }

            .context-val {
                font-size: 9pt;
                font-weight: bold;
                color: #0B2345;
            }

            /* ── KPI Metrics Table ── */
            .metrics-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 14px;
            }

            .metrics-table td {
                width: 25%;
                padding: 8px 10px;
                text-align: center;
                border: 1px solid #CBD5E1;
                border-radius: 3px;
            }

            .metric-box-total { background-color: #F1F5F9; }
            .metric-box-pass { background-color: #ECFDF5; border-color: #A7F3D0 !important; }
            .metric-box-issue { background-color: #FEF2F2; border-color: #FECACA !important; }
            .metric-box-na { background-color: #F8FAFC; border-color: #E2E8F0 !important; }

            .metric-number {
                font-size: 14pt;
                font-weight: bold;
                display: block;
            }
            .metric-number-total { color: #0B2345; }
            .metric-number-pass { color: #047857; }
            .metric-number-issue { color: #B91C1C; }
            .metric-number-na { color: #64748B; }

            .metric-caption {
                font-size: 7.5pt;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                color: #475569;
                margin-top: 2px;
                display: block;
            }

            /* ── Section Titles ── */
            .section-header {
                background-color: #0B2345;
                color: #FFFFFF;
                font-size: 9.5pt;
                font-weight: bold;
                padding: 6px 10px;
                border-radius: 3px;
                margin-top: 14px;
                margin-bottom: 6px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .category-bar {
                background-color: #E2E8F0;
                color: #0B2345;
                font-size: 8.5pt;
                font-weight: bold;
                padding: 5px 10px;
                border-left: 4px solid #0B2345;
                margin-top: 8px;
                margin-bottom: 4px;
            }

            /* ── Data Tables ── */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
                font-size: 8pt;
            }

            .data-table th {
                background-color: #102F57;
                color: #FFFFFF;
                padding: 5px 8px;
                text-align: left;
                font-size: 8pt;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                border: 1px solid #0B2345;
            }

            .data-table td {
                padding: 5px 8px;
                border: 1px solid #CBD5E1;
                vertical-align: top;
            }

            .data-table tr:nth-child(even) td {
                background-color: #F8FAFC;
            }

            /* ── Result Badges ── */
            .badge-pass {
                display: inline-block;
                background-color: #DEF7EC;
                color: #03543F;
                font-weight: bold;
                padding: 2px 6px;
                border-radius: 3px;
                border: 1px solid #31C48D;
                font-size: 7.5pt;
            }

            .badge-issue {
                display: inline-block;
                background-color: #FDE8E8;
                color: #9B1C1C;
                font-weight: bold;
                padding: 2px 6px;
                border-radius: 3px;
                border: 1px solid #F98080;
                font-size: 7.5pt;
            }

            .badge-na {
                display: inline-block;
                background-color: #F3F4F6;
                color: #4B5563;
                font-weight: bold;
                padding: 2px 6px;
                border-radius: 3px;
                border: 1px solid #D1D5DB;
                font-size: 7.5pt;
            }

            .badge-severity-critical {
                display: inline-block;
                background-color: #771D1D;
                color: #FFFFFF;
                font-weight: bold;
                padding: 2px 5px;
                border-radius: 3px;
                font-size: 7.5pt;
            }

            .badge-severity-major {
                display: inline-block;
                background-color: #C2410C;
                color: #FFFFFF;
                font-weight: bold;
                padding: 2px 5px;
                border-radius: 3px;
                font-size: 7.5pt;
            }

            .badge-severity-minor {
                display: inline-block;
                background-color: #E2E8F0;
                color: #334155;
                font-weight: bold;
                padding: 2px 5px;
                border-radius: 3px;
                font-size: 7.5pt;
            }

            /* ── Sign-off Block ── */
            .signoff-section {
                page-break-inside: avoid;
                margin-top: 18px;
                border: 1px solid #CBD5E1;
                border-radius: 4px;
                background-color: #F8FAFC;
                padding: 10px 14px;
            }

            .signoff-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }

            .signoff-table td {
                width: 33.33%;
                padding: 6px 12px;
                vertical-align: top;
            }

            .sig-line {
                border-bottom: 1px solid #475569;
                height: 36px;
                margin-bottom: 6px;
            }

            .sig-label {
                font-size: 7.5pt;
                font-weight: bold;
                color: #475569;
                text-transform: uppercase;
            }

            .sig-name {
                font-size: 8.5pt;
                color: #0F172A;
                font-weight: bold;
            }

            .page-break {
                page-break-before: always;
            }
        </style>
    </head>
    <body>
        <apex:outputPanel rendered="{!NOT(hasInspection)}">
            <div style="padding: 40px; text-align: center; color: #64748B;">
                <h2>No Inspection Record Found</h2>
                <p>The requested inspection record or handover inspection could not be loaded.</p>
            </div>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!hasInspection}">
            <!-- ──── HEADER BANNER ──── -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                <tr>
                    <td style="background-color: #0B2345; color: #FFFFFF; padding: 12px 16px; border-radius: 4px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="vertical-align: middle;">
                                    <h1 class="header-title">PROPERTY INSPECTION AUDIT REPORT</h1>
                                    <div class="header-subtitle">
                                        Handover #{!inspection.Handover__r.Name} &bull; Unit {!inspection.Handover__r.Unit__r.Name} &bull; {!inspection.Handover__r.Property__r.Name}
                                    </div>
                                </td>
                                <td style="vertical-align: middle; text-align: right;">
                                    <span class="ref-badge">{!inspection.Name}</span>
                                    <div style="font-size: 8pt; color: #CBD5E1; margin-top: 4px;">
                                        Generated: {!generatedDateFormatted}
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ──── CONTEXT DETAILS ──── -->
            <table class="context-table">
                <tr>
                    <td style="width: 25%;">
                        <span class="context-label">CUSTOMER NAME</span>
                        <span class="context-val">{!inspection.Handover__r.Customer__r.Name}</span>
                    </td>
                    <td style="width: 25%;">
                        <span class="context-label">PROPERTY &amp; TOWER</span>
                        <span class="context-val">{!inspection.Handover__r.Property__r.Name} &bull; {!inspection.Handover__r.Tower__r.Name}</span>
                    </td>
                    <td style="width: 25%;">
                        <span class="context-label">UNIT NUMBER</span>
                        <span class="context-val">{!inspection.Handover__r.Unit__r.Name}</span>
                    </td>
                    <td style="width: 25%;">
                        <span class="context-label">BOOKING REFERENCE</span>
                        <span class="context-val">#{!inspection.Handover__r.Booking__r.Name}</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <span class="context-label">LEAD AUDITOR / INSPECTOR</span>
                        <span class="context-val">{!inspection.Inspector_Name__c}</span>
                        <div style="font-size: 7.5pt; color: #64748B;">({!inspection.Inspector_Company__c})</div>
                    </td>
                    <td>
                        <span class="context-label">INSPECTION TYPE &amp; ROUND</span>
                        <span class="context-val">{!inspection.Inspection_Type__c} &bull; {!inspection.Inspection_Round__c}</span>
                    </td>
                    <td>
                        <span class="context-label">AUDIT STATUS</span>
                        <span class="context-val">{!inspection.Status__c}</span>
                    </td>
                    <td>
                        <span class="context-label">HANDOVER OWNER</span>
                        <span class="context-val">{!inspection.Handover__r.Handover_Owner__r.Name}</span>
                    </td>
                </tr>
            </table>

            <!-- ──── KPI METRICS ──── -->
            <table class="metrics-table">
                <tr>
                    <td class="metric-box-total">
                        <span class="metric-number metric-number-total">{!totalItemsCount}</span>
                        <span class="metric-caption">TOTAL CHECKPOINTS</span>
                    </td>
                    <td class="metric-box-pass">
                        <span class="metric-number metric-number-pass">{!passedItemsCount}</span>
                        <span class="metric-caption">PASSED ({!passPercentage}%)</span>
                    </td>
                    <td class="metric-box-issue">
                        <span class="metric-number metric-number-issue">{!issueItemsCount}</span>
                        <span class="metric-caption">ISSUES / DEFECTS</span>
                    </td>
                    <td class="metric-box-na">
                        <span class="metric-number metric-number-na">{!naItemsCount}</span>
                        <span class="metric-caption">NOT APPLICABLE</span>
                    </td>
                </tr>
            </table>

            <!-- ──── SECTION: GROUPED CHECKLIST AUDIT ──── -->
            <div class="section-header">CHECKLIST AUDIT FINDINGS BY CATEGORY</div>

            <apex:repeat value="{!categoryGroups}" var="grp">
                <div class="category-bar">
                    {!grp.categoryName} ({!grp.itemCount} Items &bull; Passed: {!grp.passCount} &bull; Issues: {!grp.issueCount})
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Checklist Item</th>
                            <th style="width: 25%;">Location</th>
                            <th style="width: 15%; text-align: center;">Result</th>
                            <th style="width: 20%;">Remarks / Defect</th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!grp.items}" var="itm">
                            <tr>
                                <td><strong>{!itm.name}</strong></td>
                                <td>{!itm.location}</td>
                                <td style="text-align: center;">
                                    <span class="{!itm.resultBadgeClass}">{!itm.result}</span>
                                </td>
                                <td>
                                    <apex:outputText value="{!itm.comments}" rendered="{!NOT(ISBLANK(itm.comments))}" />
                                    <apex:outputPanel rendered="{!itm.hasLinkedSnags}">
                                        <div style="color: #B91C1C; font-weight: bold; font-size: 7.5pt; margin-top: 2px;">
                                            <apex:repeat value="{!itm.linkedSnagNames}" var="sn">
                                                Defect: {!sn}<br/>
                                            </apex:repeat>
                                        </div>
                                    </apex:outputPanel>
                                </td>
                            </tr>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:repeat>

            <!-- ──── SECTION: SNAGS & DEFECTS ──── -->
            <apex:outputPanel rendered="{!hasSnags}">
                <div style="page-break-inside: avoid; margin-top: 14px;">
                    <div class="section-header">LOGGED SNAGS &amp; DEFECT RESOLUTION REGISTER</div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 12%;">Snag Ref</th>
                                <th style="width: 18%;">Category &amp; Location</th>
                                <th style="width: 10%; text-align: center;">Severity</th>
                                <th style="width: 14%;">Responsible Team</th>
                                <th style="width: 26%;">Description</th>
                                <th style="width: 10%; text-align: center;">Status</th>
                                <th style="width: 10%;">Verification</th>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:repeat value="{!snags}" var="sn">
                                <tr>
                                    <td><strong>{!sn.Name}</strong></td>
                                    <td>{!sn.Category__c} &bull; {!sn.Location__c}</td>
                                    <td style="text-align: center;">
                                        <span class="{!IF(sn.Severity__c == 'Critical', 'badge-severity-critical', IF(sn.Severity__c == 'Major', 'badge-severity-major', 'badge-severity-minor'))}">
                                            {!sn.Severity__c}
                                        </span>
                                    </td>
                                    <td>{!IF(NOT(ISBLANK(sn.Responsible_Team__c)), sn.Responsible_Team__c, sn.Assigned_Contractor_Name__c)}</td>
                                    <td>
                                        {!sn.Snag_Description__c}
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(sn.Resolution_Comments__c))}">
                                            <div style="font-size: 7pt; color: #047857; margin-top: 2px;">
                                                <strong>Rectification:</strong> {!sn.Resolution_Comments__c}
                                            </div>
                                        </apex:outputPanel>
                                    </td>
                                    <td style="text-align: center;"><strong>{!sn.Status__c}</strong></td>
                                    <td>{!IF(NOT(ISBLANK(sn.Verification_Comments__c)), sn.Verification_Comments__c, '—')}</td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                </div>
            </apex:outputPanel>

            <!-- ──── FORMAL CERTIFICATION & SIGN-OFF ──── -->
            <div class="signoff-section">
                <div style="font-weight: bold; color: #0B2345; font-size: 8.5pt; text-transform: uppercase; margin-bottom: 4px;">
                    FORMAL INSPECTION AUDIT SIGN-OFF &amp; CERTIFICATION
                </div>
                <div style="font-size: 7.5pt; color: #475569; margin-bottom: 8px;">
                    This document certifies that the residential property detailed above has undergone quality audit inspection per standard developer quality protocols.
                </div>
                <table class="signoff-table">
                    <tr>
                        <td>
                            <div class="sig-line"></div>
                            <div class="sig-name">{!inspection.Inspector_Name__c}</div>
                            <div class="sig-label">Lead Quality Auditor ({!inspection.Inspector_Company__c})</div>
                        </td>
                        <td>
                            <div class="sig-line"></div>
                            <div class="sig-name">{!inspection.Handover__r.Handover_Owner__r.Name}</div>
                            <div class="sig-label">Handover Executive / Project Lead</div>
                        </td>
                        <td>
                            <div class="sig-line"></div>
                            <div class="sig-name">{!inspection.Handover__r.Customer__r.Name}</div>
                            <div class="sig-label">Customer / Authorized Representative</div>
                        </td>
                    </tr>
                </table>
            </div>
        </apex:outputPanel>
    </body>
</apex:page>
