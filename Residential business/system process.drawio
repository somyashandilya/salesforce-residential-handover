          <mxGeometry height="218" width="2510" y="738" as="geometry" />
        </mxCell>
        <mxCell id="p2-ppappr" parent="p2-lane-APPR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Approve standard project payment plans&lt;/b&gt;&lt;br&gt;Standard plans defined by builder at project creation may also go through approval&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f5f99&quot;&gt;[OPTION]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="187" y="14" as="geometry" />
