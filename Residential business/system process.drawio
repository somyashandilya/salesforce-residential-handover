        <mxCell id="p1-dupd" parent="p1-lane-AUTO" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" value="&lt;b&gt;Duplicate match?&lt;/b&gt;&lt;br&gt;Duplicate / matching rules on phone, e-mail; household links (spouse, parent)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f5f99&quot;&gt;[OPTION]&lt;/font&gt;&lt;/i&gt;" vertex="1">
