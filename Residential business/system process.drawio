        <mxCell id="p2-lane-SALES" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=170;fillColor=#dbe7f5;swimlaneFillColor=none;strokeColor=#8a8a8a;fontSize=11;fontStyle=1;collapsible=0;" value="Sales Team" vertex="1">
