        <mxCell id="p1-q" parent="p1-lane-AUTO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;dashed=1;dashPattern=6 3;strokeWidth=1.5;" value="&lt;b&gt;Route lead to Pre-sales queue&lt;/b&gt;&lt;br&gt;Assignment always to Pre-sales first. Project-level or campaign-level queues possible, round robin within queue.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt; &lt;font color=&quot;#b85450&quot;&gt;[CONFIRM: queue rules per client]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="109" width="226" x="447" y="14" as="geometry" />
        </mxCell>
