          <mxGeometry height="96" width="226" x="1227" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-discrej" parent="p2-lane-APPR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Rejected: renegotiate / revise quote&lt;/b&gt;" vertex="1">
