        </mxCell>
        <mxCell id="p2-lane-SF" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=170;fillColor=#e6dcef;swimlaneFillColor=none;strokeColor=#8a8a8a;fontSize=11;fontStyle=1;collapsible=0;" value="Salesforce (Records)" vertex="1">
          <mxGeometry height="273" width="2510" y="956" as="geometry" />
        </mxCell>
        <mxCell id="p2-inv" parent="p2-lane-SF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Inventory records in Salesforce&lt;/b&gt;&lt;br&gt;Same hierarchy with SAP ID. Pricing held at Tower or Unit level (business call: tower level when units are identical).&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="187" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-pp" parent="p2-lane-SF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Payment Plan master (Salesforce)&lt;/b&gt;&lt;br&gt;Payment Plan + Payment Plan Schedules: installment no., milestone code (entered manually to match SAP), %, days. Created manually or data-loaded; active / inactive flag. Salesforce is master in asset (SAP for some clients).&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt; &lt;font color=&quot;#b85450&quot;&gt;[CONFIRM: master system]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="135" width="226" x="187" y="124" as="geometry" />
        </mxCell>
        <mxCell id="p2-auto_h" parent="p2-lane-SF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Project, Tower, Floor auto-populated&lt;/b&gt;&lt;br&gt;From the tagged Unit hierarchy&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
