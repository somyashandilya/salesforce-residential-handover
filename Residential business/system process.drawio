        </mxCell>
        <mxCell id="p2-tag" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Stage = Unit Shortlisting; tag Unit&lt;/b&gt;&lt;br&gt;Conversations happen on unit numbers (e.g. D-2701). One unit per opportunity.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="447" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-sv2" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Further site visits at Opportunity level&lt;/b&gt;&lt;br&gt;Allowed; at least one completed before conversion&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="83" width="226" x="447" y="124" as="geometry" />
        </mxCell>
        <mxCell id="p2-park" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Capture car parking&lt;/b&gt;&lt;br&gt;Related car-park record: slots, type (open / covered); additional car-park line with charge when extra slots requested&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt; &lt;font color=&quot;#1f5f99&quot;&gt;[OPTION: extra-slot line]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="707" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-quote" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Stage = Negotiation; create Quote&lt;/b&gt;&lt;br&gt;Pre-populated from inventory or entered manually; may upsell above standard rate (e.g. 3,000 vs 2,500 / sqft). Quote names for version tracking.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="109" width="226" x="967" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-disc" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Enter discount on Condition Charges&lt;/b&gt;&lt;br&gt;Difference between final agreed price and standard price entered as discount on overall sale value; base price untouched&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="109" width="226" x="1227" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-tok" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Agree token amount; stage = Token Amount Confirmation&lt;/b&gt;&lt;br&gt;Typically 10% of sale value, auto-calculated from backend %; negotiated in rare cases. Decided here, collected at Booking Form.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f5f99&quot;&gt;[OPTION]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="109" width="226" x="1487" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-selpp" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Stage = Payment Plan; select plan&lt;/b&gt;&lt;br&gt;OC received: date-based, e.g. 10% booking + 90% on possession within 30 days. Under construction: milestone-based, e.g. 25 x 4.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="1487" y="247" as="geometry" />
        </mxCell>
        <mxCell id="p2-cpp" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Create custom Payment Plan + schedules&lt;/b&gt;&lt;br&gt;Alter % across milestones or combine milestones; timing stays milestone-based&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="96" width="226" x="1747" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-bf" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Send Booking Form link&lt;/b&gt;&lt;br&gt;Pre-filled name, unit, price. Not in current asset.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f5f99&quot;&gt;[OPTION]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="226" x="2007" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-offline" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Offline payment (NEFT / cheque)&lt;/b&gt;&lt;br&gt;Proof uploaded manually; verified later by CRM / Finance (Page 3)" vertex="1">
          <mxGeometry height="57" width="226" x="2007" y="98" as="geometry" />
        </mxCell>
        <mxCell id="p2-cw" parent="p2-lane-SALES" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Mark Opportunity Closed Won&lt;/b&gt;&lt;br&gt;Sales role ends; Sales has no access to Booking&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5a3d7a&quot;&gt;[ASSET]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="226" x="2267" y="14" as="geometry" />
        </mxCell>
