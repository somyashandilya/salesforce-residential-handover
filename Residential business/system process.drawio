        <mxCell id="p1-dupx" parent="p1-lane-AUTO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Alert user, do not block&lt;/b&gt;&lt;br&gt;B2C duplicates cannot be fully prevented; alert so enquiries are not lost. Duplicates also used to game incentives (see Page 7).&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1f5f99&quot;&gt;[OPTION]&lt;/font&gt;&lt;/i&gt;" vertex="1">
