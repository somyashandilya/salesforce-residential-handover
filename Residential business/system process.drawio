        </mxCell>
        <mxCell id="p2-cppd" parent="p2-lane-APPR" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" value="&lt;b&gt;Approve custom plan?&lt;/b&gt;&lt;br&gt;Finance or designated team&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;[CONFIRM: approver]&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="132" width="226" x="1747" y="14" as="geometry" />
        </mxCell>
        <mxCell id="p2-cpprej" parent="p2-lane-APPR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=3;" value="&lt;b&gt;Rejected: use standard plan / renegotiate&lt;/b&gt;" vertex="1">
